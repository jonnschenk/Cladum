{
  "name": "cladum",
  "version": "1.0.0",
  "description": "Cladum: explorador de biodiversidad con datos verificables de GBIF.",
  "private": true,
  "type": "module",
  "scripts": {
    "sass:watch": "sass --watch scss/main.scss:css/main.css",
    "build": "sass scss/main.scss:css/main.css --style=compressed --no-source-map",
    "serve": "npx --yes serve . -l 5500"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
